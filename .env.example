# Скопіюйте цей файл у .env і заповніть значення.

# Домен, на якому працюватиме CRM (запис A має вказувати на IP сервера)
DOMAIN=crm.example.com

# Пароль бази даних — довгий випадковий рядок
DB_PASSWORD=change-me-long-random-password

# Секрет для підпису сесій — довгий випадковий рядок (openssl rand -hex 32)
SECRET_KEY=change-me-64-random-chars

# Перший адміністратор (створюється при першому запуску, потім змініть пароль у профілі)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Cookie лише через HTTPS (залиште 1, якщо працюєте через Caddy з доменом)
HTTPS_ONLY=1

DISPLAY_TZ=Europe/Kyiv
WEB_WORKERS=2
WORKER_TICK=30
